// Resources for bangla-panel.exe — the app icon (real logo, shared with the tray) + version info.
// build-all.sh copies tray/banglakeyboard.ico here before running windres.
#include <windows.h>

1 ICON "banglakeyboard.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,1,5,0
 PRODUCTVERSION 1,1,5,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AiCMS.BD"
            VALUE "FileDescription",  "Bangla Keyboard (preview panel)"
            VALUE "FileVersion",      "1.1.5.0"
            VALUE "InternalName",     "bangla-panel"
            VALUE "LegalCopyright",   "Copyright (C) 2026 AiCMS.BD"
            VALUE "OriginalFilename", "bangla-panel.exe"
            VALUE "ProductName",      "Bangla Keyboard"
            VALUE "ProductVersion",   "1.1.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
